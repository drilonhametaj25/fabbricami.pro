# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_erp?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=100y
JWT_REFRESH_EXPIRES_IN=100y

# WordPress Integration
WORDPRESS_URL=https://ecommerceerp.com
WORDPRESS_API_KEY=ck_b5d1f169411002b00db98db65d578132e26a76e7
WORDPRESS_WEBHOOK_SECRET=cs_2b4dfe5f7c071ccc90c3686a0c30fa51b955692b

# Email (per notifiche)
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=info@drilonhametaj.it
SMTP_PASSWORD=unused_use_SMTP_PASS_instead

# Barcode Scanner
BARCODE_WEBSOCKET_PORT=3101

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Logging
LOG_LEVEL=debug
ELASTICSEARCH_NODE=http://elasticsearch:9200

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000

# Costi generali (spalmare su ore lavorate o volumi)
OVERHEAD_ALLOCATION_METHOD=labor_hours

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Frontend
VITE_API_URL=http://localhost:3100
VITE_WS_URL=ws://localhost:3101

# CORS (per produzione)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3100,http://localhost:3001

